generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  HOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PropertyType {
  HOTEL
  VILLA
  HOSTEL
  APARTMENT
}

model User {
  id              String     @id @default(cuid())
  name            String?
  email           String     @unique
  provider        String
  providerId      String
  picture         String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  role            Role       @default(USER)
  properties      Property[] @relation("HostProperties")
  bookings        Booking[]
  payments        Payment[]
  reviews         Review[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Property {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  price       Float
  location    String
  latitude    Float
  longitude   Float
  images      String[]
  type        PropertyType
  host        User        @relation("HostProperties", fields: [hostId], references: [id])
  hostId      String
  bookings    Booking[]
  reviews     Review[]
  amenities   Amenity[]   @relation("PropertyAmenities")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Booking {
  id          Int           @id @default(autoincrement())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  property    Property      @relation(fields: [propertyId], references: [id])
  propertyId  Int
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  payment     Payment?      @relation("BookingPayment")
  paymentId   Int?          @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Payment {
  id          Int           @id @default(autoincrement())
  amount      Float
  status      PaymentStatus @default(PENDING)
  booking     Booking?      @relation("BookingPayment", fields: [bookingId], references: [id])
  bookingId   Int?          @unique
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Amenity {
  id          Int         @id @default(autoincrement())
  name        String
  properties  Property[]  @relation("PropertyAmenities")
}

model Review {
  id          Int         @id @default(autoincrement())
  rating      Int
  comment     String?
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  property    Property    @relation(fields: [propertyId], references: [id])
  propertyId  Int
  createdAt   DateTime    @default(now())
}
