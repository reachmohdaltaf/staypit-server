{
  "compilerOptions": {
    /* Basic settings */
    "target": "ES2020",                     // Modern JS features
    "module": "commonjs",                   // For Node.js
    "rootDir": "./src",                     // Where .ts files are
    "outDir": "./build",                    // Where .js files go after build
    "strict": true,                         // Enables all strict type-checking
    "esModuleInterop": true,                // Allow default imports from CommonJS
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,                   // Skip checking node_modules types

    /* Optional useful extras */
    "resolveJsonModule": true,              // Allow import of JSON files
    "moduleResolution": "node",             // Use Node-style module resolution
    "allowSyntheticDefaultImports": true    // Helps with default import compatibility
  },
  "include": ["src"],                       // Only compile files in /src
  "exclude": ["node_modules", "build"]      // Exclude output and dependencies
}
